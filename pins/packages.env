# Pins for the packages this repository builds with melange and serves from
# the ForkLaunch apk repository. scripts/refresh-pins.sh rewrites the Node and
# Bun and Pulumi lines nightly; pnpm moves only when edited by hand.
# *_EPOCH is the package release (-rN). Bump it when a recipe changes without
# an upstream version change; refresh-pins.sh resets it to 0 on a new version.

# Node.js, compiled from the nodejs.org source tarball. The sha256 comes from
# SHASUMS256.txt, whose signature is checked against keys/nodejs-release-keys.kbx.
NODE_24_VERSION=24.22.3
NODE_24_SHA256=48ca3aa8a9b02133356922ef4fc80200e00598c80a4ef446f7c39a459222593d
NODE_24_EPOCH=0
NODE_26_VERSION=26.13.1
NODE_26_SHA256=a7f6204ff63b6a2cd274d48903285abb86ed53a99070e532d4c2fd787457d9e6
NODE_26_EPOCH=0

# pnpm (npm registry tarball, sha512 of the registry's integrity value).
PNPM_VERSION=11.21.0
PNPM_SHA512=521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1
PNPM_EPOCH=0

# Pulumi (official release; sha256 from the release checksums file, checked
# against GitHub's asset digest). Refreshed nightly to the newest release.
PULUMI_VERSION=3.278.0
PULUMI_SHA256_X86_64=bc1b25c6ae82793ba1f0b890b2a6c0d380652694e42e8a2556736071eda9f583
PULUMI_SHA256_AARCH64=35de8596e629caf1556ac7560cdbd5b09a07a096dda0e0dd035d09bb5a3287cb
PULUMI_EPOCH=0

# Bun: Wolfi's package when Wolfi carries the newest upstream release
# (BUN_SOURCE=wolfi; the version pin is then in pins/bun.txt), otherwise our
# repackaging of the official release (BUN_SOURCE=forklaunch, packages/bun.yaml.in).
BUN_SOURCE=wolfi
BUN_VERSION=1.4.5
BUN_SHA256_X86_64=94559b3b528995a49452f9f2404cec74f2efd7d06e0a000a8cd214b02c3666eb
BUN_SHA256_AARCH64=18656a3bf0ea5641f5796ae4213b75255579a70a0fded2f337933785568cdf84
BUN_EPOCH=0

# Node majors built and published, and the one platform-toolchain uses.
NODE_MAJORS="24 26"
PLATFORM_NODE_MAJOR=26

# docker-entrypoint.sh from nodejs/docker-node at a fixed commit (by hand).
NODE_ENTRYPOINT_VERSION=0_git20260526
NODE_ENTRYPOINT_COMMIT=31a343bbe3f11b8262527104d2ae84fec34ce3c5
NODE_ENTRYPOINT_SHA256=a15ac9589c04baf9da95b08e0e79b5cf1d75ab8dc64e06a5e68e4ceb0ad7c8ea
NODE_ENTRYPOINT_EPOCH=0
