# rust runtime: what a Rust service binary needs at run time. libssl.so.3 and
# libcrypto.so.3 come from OpenSSL 3.6 (Wolfi's default OpenSSL is 4.0), so
# binaries built on Debian or in rust:dev both load.
contents:
  repositories:
    - @@WOLFI_REPO_URL@@
    - "@forklaunch @@APK_REPO_URL@@"
  keyring:
    - @@WOLFI_KEY@@
    - @@APK_KEY@@
  packages:
    - wolfi-base
    - ca-certificates-bundle
    - curl
    - openssl-3.6-libssl
    - openssl-3.6-libcrypto
    - libgcc

accounts:
  groups:
    - groupname: nonroot
      gid: 65532
    - groupname: app
      gid: 1000
  users:
    - username: nonroot
      uid: 65532
      gid: 65532
      homedir: /home/nonroot
      shell: /bin/sh
    - username: app
      uid: 1000
      gid: 1000
      homedir: /home/app
      shell: /bin/sh
  run-as: "65532"

paths:
  - path: /home/nonroot
    type: directory
    uid: 65532
    gid: 65532
    permissions: 0o755
  - path: /home/app
    type: directory
    uid: 1000
    gid: 1000
    permissions: 0o755

environment:
  PATH: /usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

cmd: /bin/sh -l

annotations:
  org.opencontainers.image.source: https://github.com/forklaunch/base-images
  org.opencontainers.image.vendor: ForkLaunch
  org.opencontainers.image.title: "rust runtime"
  org.opencontainers.image.revision: "@@GIT_SHA@@"

archs: [x86_64, aarch64]
