# rust:dev: the Rust toolchain for build stages. Builds against OpenSSL 3.6
# (openssl-3.6-dev), so binaries pair with the runtime image's libssl.so.3.
contents:
  repositories:
    - @@WOLFI_REPO_URL@@
    - "@forklaunch @@APK_REPO_URL@@"
  keyring:
    - @@WOLFI_KEY@@
    - @@APK_KEY@@
  packages:
    - wolfi-base
    - ca-certificates-bundle
    - curl
    - openssl-3.6-libssl
    - openssl-3.6-libcrypto
    - libgcc
    - rust-@@RUST_MINOR@@
    - pkgconf
    - openssl-3.6-dev
    - build-base
    - perl
    - cmake
    - git

accounts:
  groups:
    - groupname: nonroot
      gid: 65532
    - groupname: app
      gid: 1000
  users:
    - username: nonroot
      uid: 65532
      gid: 65532
      homedir: /home/nonroot
      shell: /bin/sh
    - username: app
      uid: 1000
      gid: 1000
      homedir: /home/app
      shell: /bin/sh
  run-as: root

paths:
  - path: /home/nonroot
    type: directory
    uid: 65532
    gid: 65532
    permissions: 0o755
  - path: /home/app
    type: directory
    uid: 1000
    gid: 1000
    permissions: 0o755
  - path: /usr/local/cargo
    type: directory
    uid: 0
    gid: 0
    permissions: 0o755

environment:
  RUST_VERSION: "@@RUST_VERSION@@"
  CARGO_HOME: /usr/local/cargo
  PATH: /usr/local/cargo/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

cmd: /bin/sh -l

annotations:
  org.opencontainers.image.source: https://github.com/forklaunch/base-images
  org.opencontainers.image.vendor: ForkLaunch
  org.opencontainers.image.title: "rust @@RUST_VERSION@@ dev"
  org.opencontainers.image.version: "@@RUST_VERSION@@"
  org.opencontainers.image.revision: "@@GIT_SHA@@"

archs: [x86_64, aarch64]
