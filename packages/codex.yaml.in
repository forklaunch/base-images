# OpenAI Codex CLI from the GitHub release (static musl build), checked against
# the sha256 digest GitHub records for the release asset (pins/packages.env).
package:
  name: codex
  version: "@@CODEX_VERSION@@"
  epoch: @@CODEX_EPOCH@@
  description: "OpenAI Codex CLI (upstream release binary)"
  copyright:
    - license: Apache-2.0
  options:
    no-depends: true

environment:
  contents:
    packages:
      - busybox

pipeline:
  - if: ${{build.arch}} == 'x86_64'
    uses: fetch
    with:
      uri: https://github.com/openai/codex/releases/download/rust-v${{package.version}}/codex-x86_64-unknown-linux-musl.tar.gz
      expected-sha256: @@CODEX_SHA256_X86_64@@
      strip-components: 0
  - if: ${{build.arch}} == 'aarch64'
    uses: fetch
    with:
      uri: https://github.com/openai/codex/releases/download/rust-v${{package.version}}/codex-aarch64-unknown-linux-musl.tar.gz
      expected-sha256: @@CODEX_SHA256_AARCH64@@
      strip-components: 0
  - runs: |
      install -Dm755 "codex-${{build.arch}}-unknown-linux-musl" "${{targets.destdir}}/usr/bin/codex"

test:
  pipeline:
    - runs: codex --version | grep -F "${{package.version}}"
