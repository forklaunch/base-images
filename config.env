# Shared settings for the build scripts and the nightly workflow.
# Scripts read this file with `set -a; . ./config.env; set +a`.

AWS_ACCOUNT_ID=038774803424
# Private ECR (staging) and S3 live here. Public ECR APIs are always us-east-1.
AWS_REGION=us-east-1

# Public ECR registry alias. Until the "forklaunch" alias is approved, this is
# the registry's default alias. Change this one value after the alias lands;
# everything else (README examples aside) derives from it.
PUBLIC_REGISTRY_ALIAS=e6h0t2z8
PUBLIC_REGISTRY=public.ecr.aws/${PUBLIC_REGISTRY_ALIAS}

# Private staging repos: <account>.dkr.ecr.<region>.amazonaws.com/base-images-staging/<image>
STAGING_PREFIX=base-images-staging
STAGING_REGISTRY=${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

# Signed apk repository holding the packages built here (Node, pnpm, codex, ...).
APK_BUCKET=forklaunch-apk
APK_REPO_PATH=os
APK_REPO_URL=https://${APK_BUCKET}.s3.${AWS_REGION}.amazonaws.com/${APK_REPO_PATH}
APK_KEY_NAME=forklaunch-melange.rsa.pub

# Upstream Wolfi repository and its signing key.
WOLFI_REPO_URL=https://packages.wolfi.dev/os
WOLFI_KEY_URL=https://packages.wolfi.dev/os/wolfi-signing.rsa.pub

# Secrets Manager secret holding the melange private key (PEM).
SIGNING_KEY_SECRET_ID=base-images/melange-signing-key

# IAM role assumed by the workflow through GitHub OIDC.
CI_ROLE_ARN=arn:aws:iam::${AWS_ACCOUNT_ID}:role/forklaunch-base-images-ci

# Images and the architectures every image is built for.
IMAGES="node bun rust platform-toolchain"
ARCHES="x86_64 aarch64"

# Subject prefix of this repository's GitHub OIDC tokens. The repository uses
# GitHub's immutable subject claims (owner and repository IDs next to the
# names), so tokens say repo:forklaunch@<org-id>/base-images@<repo-id>:...
# (gh api repos/forklaunch/base-images/actions/oidc/customization/sub).
GITHUB_OIDC_SUB_PREFIX=repo:forklaunch@169505310/base-images@1473769631
