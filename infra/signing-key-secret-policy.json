{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "OnlyTheCiRoleReadsTheKey",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "*",
      "Condition": {
        "StringNotEquals": {
          "aws:PrincipalArn": "arn:aws:iam::@@ACCOUNT@@:role/forklaunch-base-images-ci"
        }
      }
    },
    {
      "Sid": "AllowTheCiRole",
      "Effect": "Allow",
      "Principal": { "AWS": "arn:aws:iam::@@ACCOUNT@@:role/forklaunch-base-images-ci" },
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "*"
    }
  ]
}
