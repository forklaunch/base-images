{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PublicReadOfApkRepository",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::@@BUCKET@@/@@APK_REPO_PATH@@/*"
    },
    {
      "Sid": "TlsOnly",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": ["arn:aws:s3:::@@BUCKET@@", "arn:aws:s3:::@@BUCKET@@/*"],
      "Condition": { "Bool": { "aws:SecureTransport": "false" } }
    }
  ]
}
